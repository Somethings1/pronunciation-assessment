  yval_ac_modified = np.zeros((num_sequences_val, sequence_length, 1), dtype=int)

  yval_ac_reshaped = yval_ac.reshape((num_sequences_val, sequence_length, 1))

  yval_ac_modified[:, :, 0] = yval_ac_reshaped[:, :, 0]

